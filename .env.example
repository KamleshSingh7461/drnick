# This project is a static React frontend built with Vite.
# Based on a comprehensive scan of the codebase, there are NO custom environment 
# variables (e.g., API keys, custom backend URLs, or secrets) required to run this app.

# Vite uses the following built-in environment variable in `src/components/Header.tsx`:
# import.meta.env.BASE_URL 
# (This is automatically configured by the `base` option in vite.config.ts)

# If you plan to add a backend API in the future, you can define your variables here.
# Note: Vite environment variables must be prefixed with `VITE_`.
# VITE_API_BASE_URL=http://localhost:8080/api
